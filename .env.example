# Gemini API (REQUIRED)
GEMINI_API_KEY=your_api_key_here

# Optional: override model (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# ChromaDB (Optional - defaults provided)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=courseflow_docs

# SQLite Database (Optional)
DATABASE_URL=sqlite+aiosqlite:///./data/courseflow.db

# Rate Limiting (Optional)
RATE_LIMIT_RPM=15
RATE_LIMIT_DAILY=1500

# Vector Search (Optional)
SIMILARITY_THRESHOLD=0.5
TOP_K_RESULTS=3

# API Configuration (Optional)
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*

# Timeouts (Optional)
LLM_TIMEOUT_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=10

# Logging (Optional)
LOG_LEVEL=INFO

# Local Development Helpers (Optional)
LOCAL_UNLIMITED=true
MOCK_QUERY_MODE=false
